---
import { Image } from "astro:assets";
import type { Expert } from "../../config/experts";

interface Props {
	expert: Expert;
}

const { expert } = Astro.props;
---

<!-- Hallmark · expert profile: photographic macro — portrait-led, hairline rows, no eyebrow pills, no 3-col cards -->

<!-- Hero — portrait right, text left, asymmetric -->
<section class="pt-36 md:pt-44 pb-20 px-6 md:px-12 lg:px-24 bg-surface">
	<div class="max-w-6xl mx-auto">
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
			<div class="lg:col-span-7 reveal-on-scroll order-2 lg:order-1">
				<p class="text-xs uppercase tracking-widest text-primary font-medium mb-5">{expert.role}</p>
				<h1 class="font-serif text-4xl md:text-6xl leading-[1.1] mb-6 text-balance">
					{expert.name}
				</h1>
				<p class="text-xl text-ink-soft leading-relaxed mb-8 max-w-xl">
					{expert.description}
				</p>
				<a
					href={`mailto:${expert.email}`}
					class="inline-flex items-center gap-2 text-foreground border-b-2 border-foreground pb-1 hover:border-primary hover:text-primary transition-colors"
				>
					{expert.email}
				</a>
			</div>
			<div class="lg:col-span-5 reveal-on-scroll order-1 lg:order-2">
				<div class="relative aspect-[4/5] max-w-md mx-auto lg:max-w-none overflow-hidden bg-muted">
					<Image
						src={expert.image}
						alt={expert.name}
						width={800}
						height={1000}
						widths={[400, 800]}
						sizes="(max-width: 1024px) 448px, 800px"
						format="webp"
						class="w-full h-full object-cover"
						loading="eager"
						fetchpriority="high"
					/>
				</div>
			</div>
		</div>
	</div>
</section>

<!-- Bio — long document, single wide column -->
<section class="py-20 md:py-24 px-6 md:px-12 lg:px-24">
	<div class="max-w-3xl mx-auto reveal-on-scroll">
		<h2 class="font-serif text-2xl md:text-3xl mb-6 text-balance leading-tight">
			Poznaj {expert.name.split(" ")[0]}a
		</h2>
		<p class="text-lg text-ink-soft leading-relaxed text-balance">
			{expert.fullBio}
		</p>
	</div>
</section>

{expert.technologies.length > 0 && (
	<section class="py-16 md:py-20 px-6 md:px-12 lg:px-24 bg-surface">
		<div class="max-w-6xl mx-auto">
			<div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-10 reveal-on-scroll">
				<div class="md:col-span-4">
					<h2 class="font-serif text-2xl md:text-3xl leading-tight">Stack technologiczny</h2>
				</div>
				<div class="md:col-span-8 flex flex-wrap gap-2.5">
					{expert.technologies.map((tech) => (
						<span class="inline-block bg-card border border-border px-4 py-2 text-sm font-medium text-foreground">
							{tech}
						</span>
					))}
				</div>
			</div>
		</div>
	</section>
)}

{expert.publications.length > 0 && (
	<section class="py-20 md:py-24 px-6 md:px-12 lg:px-24">
		<div class="max-w-6xl mx-auto">
			<div class="mb-10 reveal-on-scroll max-w-3xl">
				<h2 class="font-serif text-2xl md:text-3xl leading-tight mb-3">Teksty branżowe</h2>
				<p class="text-ink-soft">Publikacje {expert.name.split(" ")[0]}a w prasie i na blogach branżowych.</p>
			</div>
			<div class="border-t-2 border-foreground">
				{expert.publications.map((pub) => (
					<a
						href={pub.url}
						target="_blank"
						rel="noopener noreferrer"
						class="group grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 py-6 md:py-8 border-b border-border-strong reveal-on-scroll hover:bg-muted/40 transition-colors -mx-4 px-4 rounded-sm"
					>
						{pub.image ? (
							<div class="md:col-span-3">
								<img src={pub.image} alt="" class="w-full h-32 object-cover" loading="lazy" />
							</div>
						) : null}
						<div class={pub.image ? "md:col-span-9" : "md:col-span-12"}>
							<p class="text-base md:text-lg text-foreground leading-snug group-hover:text-primary transition-colors">
								{pub.title}
							</p>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>
)}

<!-- Experience — timeline as hairline rows, highlights as 2-col -->
<section class="py-20 md:py-24 px-6 md:px-12 lg:px-24 bg-surface">
	<div class="max-w-6xl mx-auto">
		<div class="mb-12 reveal-on-scroll max-w-3xl">
			<h2 class="font-serif text-2xl md:text-3xl leading-tight mb-3">
				{expert.experience.title} zawodowe
			</h2>
			<p class="text-lg text-ink-soft leading-relaxed">
				{expert.experience.summary}
			</p>
		</div>

		<!-- Timeline — hairline rows, not 3-col cards -->
		<div class="border-t-2 border-foreground mb-12">
			{expert.experience.timeline.map((item) => (
				<div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 py-7 md:py-8 border-b border-border-strong reveal-on-scroll">
					<div class="md:col-span-3">
						<p class="text-sm text-muted-foreground tabular-nums">{item.period}</p>
					</div>
					<div class="md:col-span-9">
						<h3 class="font-serif text-lg md:text-xl text-foreground mb-1">{item.role}</h3>
						<p class="text-sm font-medium text-primary mb-2">{item.company}</p>
						{item.description && (
							<p class="text-sm text-ink-soft leading-relaxed">{item.description}</p>
						)}
					</div>
				</div>
			))}
		</div>

		<!-- Highlights + LinkedIn — 2-col, not 3-col cards -->
		<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
			{expert.experience.highlights.map((h) => (
				<div class="border-t border-border-strong pt-5 reveal-on-scroll">
					<p class="text-xs uppercase tracking-widest text-primary font-medium mb-2">{h.label}</p>
					<p class="text-base text-ink-soft leading-relaxed">{h.value}</p>
				</div>
			))}
			<div class="border-t border-border-strong pt-5 reveal-on-scroll flex items-start">
				<a
					href={expert.linkedin}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-2 text-foreground border-b-2 border-foreground pb-1 hover:border-primary hover:text-primary transition-colors"
				>
					<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
						<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
					</svg>
					Pełny profil na LinkedIn
				</a>
			</div>
		</div>
	</div>
</section>

<!-- Closing CTA — letter-style, not centered pill card -->
<section class="py-20 md:py-28 px-6 md:px-12 lg:px-24">
	<div class="max-w-3xl mx-auto text-center reveal-on-scroll">
		<h2 class="font-serif text-3xl md:text-5xl leading-tight mb-6 text-balance">
			Porozmawiaj z {expert.name.split(" ")[0]}em
		</h2>
		<p class="text-lg text-ink-soft max-w-xl mx-auto mb-10 leading-relaxed">
			Masz pytania w danej dziedzinie? Napisz bezpośrednio — odpowiemy w ciągu 24h w dni robocze.
		</p>
		<div class="flex flex-col sm:flex-row items-center justify-center gap-4">
			<a
				href={`mailto:${expert.email}`}
				class="inline-flex items-center bg-primary text-white px-7 py-3.5 rounded-full font-medium hover:bg-primary-ink transition-colors whitespace-nowrap"
			>
				Napisz do {expert.name.split(" ")[0]}a
			</a>
			<a
				href="/kontakt"
				class="inline-flex items-center text-foreground border border-border-strong px-7 py-3.5 rounded-full font-medium hover:bg-muted transition-colors whitespace-nowrap"
			>
				Formularz kontaktowy
			</a>
		</div>
	</div>
</section>
