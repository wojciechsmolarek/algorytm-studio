---
interface ServiceItem {
	num: string;
	title: string;
	description: string;
	tags: string[];
	href: string;
}

interface Props {
	services: ServiceItem[];
}

const { services } = Astro.props;

// Bento spans — varied, breaks the 4-col identical grid (gate: 3-col feature grid)
const spans = [
	"lg:col-span-6",  // 01 — large
	"lg:col-span-6",  // 02 — large
	"lg:col-span-4",  // 03
	"lg:col-span-4",  // 04
	"lg:col-span-4",  // 05
	"lg:col-span-6",  // 06
	"lg:col-span-6",  // 07
	"lg:col-span-12", // 08 — wide closing
];
---

<!-- Hallmark · services: bento grid — varied spans, no identical 4-col, no icon-tile -->
<section class="py-24 md:py-32 px-6 md:px-12 lg:px-24" id="services">
	<div class="max-w-6xl mx-auto">
		<!-- Section head — left-aligned, no eyebrow pill -->
		<div class="mb-14 md:mb-16 reveal-on-scroll max-w-3xl">
			<h2 class="font-serif text-3xl md:text-5xl leading-tight text-balance mb-4">
				W czym możemy Ci pomóc?
			</h2>
			<p class="text-lg text-ink-soft leading-relaxed">
				Osiem usług, które realnie wpływają na wzrost Twojego biznesu online.
			</p>
		</div>

		<!-- Bento — 12-col on lg, 6-col on md, 1-col mobile. minmax(0,1fr) tracks (gate 50) -->
		<div class="grid grid-cols-1 md:grid-cols-6 lg:grid-cols-12 gap-4 md:gap-5">
			{services.map((service, i) => (
				<a
					href={service.href}
					class={`group bg-card border border-border p-7 md:p-8 flex flex-col reveal-on-scroll hover:border-foreground transition-colors duration-200 ${spans[i] ?? "lg:col-span-4"}`}
				>
					<div class="flex items-baseline gap-3 mb-4">
						<span class="font-serif text-sm text-muted-foreground tabular-nums">{service.num}</span>
						<h3 class="font-serif text-xl md:text-2xl text-foreground leading-tight">{service.title}</h3>
					</div>
					<p class="text-sm text-ink-soft leading-relaxed mb-5 flex-grow">{service.description}</p>
					<div class="flex flex-wrap gap-2 mb-5">
						{service.tags.map((tag) => (
							<span class="inline-block text-xs text-muted-foreground border border-border px-2.5 py-1 rounded-full">
								{tag}
							</span>
						))}
					</div>
					<span class="text-sm text-foreground border-b border-foreground/30 group-hover:border-foreground transition-colors self-start">
						Zobacz więcej →
					</span>
				</a>
			))}
		</div>

		<!-- Closing — left-aligned text link, not centered pill -->
		<div class="mt-14 reveal-on-scroll">
			<a
				class="inline-flex items-center gap-2 font-serif text-xl text-foreground border-b-2 border-foreground pb-1 hover:border-primary hover:text-primary transition-colors"
				href="#contact"
			>
				Porozmawiajmy o Twoim projekcie →
			</a>
		</div>
	</div>
</section>
