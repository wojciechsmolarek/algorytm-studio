---
interface StrategyColumn {
	title: string;
	description: string;
}

interface Props {
	headline: string;
	columns: StrategyColumn[];
}

const { headline, columns } = Astro.props;
---

<!-- Hallmark · strategy: long-document numbered list — hairline rows, not 3 identical cards -->
<section class="py-24 md:py-32 px-6 md:px-12 lg:px-24 bg-surface">
	<div class="max-w-6xl mx-auto">
		<!-- Section head — left-aligned, no eyebrow pill -->
		<div class="mb-14 md:mb-16 reveal-on-scroll max-w-3xl">
			<h2 class="font-serif text-3xl md:text-5xl leading-tight text-balance mb-4">
				{headline}
			</h2>
			<p class="text-lg text-ink-soft leading-relaxed">
				Każdy projekt traktujemy jak własny. Nie sprzedajemy szablonów — budujemy rozwiązania dopasowane do Twojego biznesu.
			</p>
		</div>

		<!-- Numbered list — full-width rows with hairline dividers -->
		<div class="border-t-2 border-foreground">
			{columns.map((col, i) => (
				<div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 py-8 md:py-10 border-b border-border-strong reveal-on-scroll">
					<div class="md:col-span-2">
						<span class="font-serif text-2xl text-primary tabular-nums">
							{String(i + 1).padStart(2, "0")}
						</span>
					</div>
					<div class="md:col-span-4">
						<h3 class="font-serif text-xl md:text-2xl text-foreground leading-tight">{col.title}</h3>
					</div>
					<div class="md:col-span-6">
						<p class="text-base text-ink-soft leading-relaxed" set:html={col.description} />
					</div>
				</div>
			))}
		</div>
	</div>
</section>
