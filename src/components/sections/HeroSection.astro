---
interface Props {
	title: string;
	subtitle: string;
	primaryCta: { text: string; href: string };
	secondaryCta: { text: string; href: string };
}

const { title, subtitle, primaryCta, secondaryCta } = Astro.props;
---

<!-- Hallmark · hero: asymmetric, left-biased, typographic anchor — no AI image, no centering -->
<header class="relative pt-36 md:pt-44 pb-20 md:pb-28 px-6 md:px-12 lg:px-24 bg-surface">
	<!-- Hairline rule top — editorial divider, not gradient blob -->
	<div class="absolute top-24 left-6 md:left-12 lg:left-24 right-6 md:right-12 lg:right-24 h-px bg-border-strong"></div>

	<div class="max-w-6xl mx-auto w-full">
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-end">
			<!-- Headline — 8 cols, left-biased -->
			<div class="lg:col-span-8 reveal-on-scroll">
				<h1
					class="font-serif text-[2.5rem] leading-[1.08] md:text-6xl lg:text-7xl tracking-tight text-foreground text-balance"
					set:html={title}
				/>
			</div>

			<!-- Meta column — 4 cols, right-aligned baseline -->
			<div class="lg:col-span-4 reveal-on-scroll">
				<p class="text-xs uppercase tracking-widest text-muted-foreground mb-3">Studio Algorytm</p>
				<p class="text-sm text-ink-soft leading-relaxed">
					Bydgoszcz, Polska · kolektyw od 2019
				</p>
			</div>
		</div>

		<!-- Subtitle + CTAs — full width below, with left indent on desktop -->
		<div class="mt-12 lg:mt-16 grid grid-cols-1 lg:grid-cols-12 gap-8">
			<div class="lg:col-span-7 reveal-on-scroll">
				<p class="text-lg md:text-xl text-ink-soft leading-relaxed max-w-2xl" set:html={subtitle} />
			</div>
			<div class="lg:col-span-5 flex flex-wrap gap-3 lg:justify-end items-start reveal-on-scroll">
				<a
					class="inline-flex items-center bg-primary text-white px-7 py-3.5 rounded-full font-medium hover:bg-primary-ink transition-colors whitespace-nowrap"
					href={primaryCta.href}
				>
					{primaryCta.text}
				</a>
				<a
					class="inline-flex items-center bg-transparent text-foreground border border-border-strong px-7 py-3.5 rounded-full font-medium hover:bg-muted transition-colors whitespace-nowrap"
					href={secondaryCta.href}
				>
					{secondaryCta.text}
				</a>
			</div>
		</div>
	</div>
</header>
