---
interface Props {
	tagline: string;
	headline: string;
	description: string;
}

const { tagline, headline, description } = Astro.props;
---

<!-- Hallmark · why-us: statement section — no gradient blob, no eyebrow pill, asymmetric 7/5 -->
<section class="py-24 md:py-32 px-6 md:px-12 lg:px-24 bg-surface">
	<div class="max-w-6xl mx-auto">
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
			<!-- Headline — 7 cols -->
			<div class="lg:col-span-7 reveal-on-scroll">
				<p class="text-xs uppercase tracking-widest text-muted-foreground mb-6">{tagline}</p>
				<h2
					class="font-serif text-3xl md:text-5xl lg:text-6xl leading-[1.1] text-foreground text-balance"
					set:html={headline}
				/>
			</div>

			<!-- Description — 5 cols, with hairline top rule -->
			<div class="lg:col-span-5 reveal-on-scroll">
				<div class="border-t-2 border-foreground pt-6 lg:mt-12">
					<p class="text-lg text-ink-soft leading-relaxed">{description}</p>
				</div>
			</div>
		</div>
	</div>
</section>
