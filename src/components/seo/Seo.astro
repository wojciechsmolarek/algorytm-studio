---
import type { ImageMetadata } from "astro";
interface Props {
    title?: string;
    description?: string;
    canonical?: string;
    ogImage?: string | ImageMetadata;
    ogType?: string;
    ignoreTitleTemplate?: boolean;
}

import { siteConfig } from "../../config/site";

const {
    title,
    description = siteConfig.description,
    canonical,
    ogImage = siteConfig.ogImage,
    ogType = "website",
    ignoreTitleTemplate = false,
} = Astro.props;

const ogImageSrc = typeof ogImage === "string" ? ogImage : ogImage.src;
const ogImageWidth = typeof ogImage === "string" ? undefined : ogImage.width;
const ogImageHeight = typeof ogImage === "string" ? undefined : ogImage.height;

const fullTitle =
    title && !ignoreTitleTemplate
        ? `${title} | ${siteConfig.name}`
        : title || siteConfig.name;

const truncatedDescription =
    description && description.length > 150
        ? description.slice(0, 147).trimEnd() + "..."
        : description;

const normalizeTrailingSlash = (pathname: string) => {
    if (pathname === "/") return pathname;
    return pathname.endsWith("/") ? pathname.slice(0, -1) : pathname;
};

const canonicalPath = normalizeTrailingSlash(Astro.url.pathname);
const canonicalURL =
    canonical ?? new URL(canonicalPath, siteConfig.url).toString();
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/images/logo/logo-mark.svg" />
<link rel="icon" type="image/x-icon" href="/images/logo/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" href="/images/logo/apple-touch-icon-180x180.png" />
<link rel="canonical" href={canonicalURL} />
<meta name="generator" content={Astro.generator} />

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={truncatedDescription} />
<meta name="author" content={siteConfig.author} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={truncatedDescription} />
<meta property="og:image" content={new URL(ogImageSrc, siteConfig.url)} />
{ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
{ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
<meta property="og:image:alt" content={fullTitle} />
<meta property="og:locale" content={siteConfig.locale} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={truncatedDescription} />
<meta name="twitter:image" content={new URL(ogImageSrc, siteConfig.url)} />
{
    siteConfig.socialLinks.twitter && (
        <meta name="twitter:site" content={siteConfig.socialLinks.twitter} />
    )
}
