---
import {
    buildGraph,
    buildSchema,
    type SchemaType,
    type SchemaItem,
} from "../../lib/schema";

interface Props {
    type?: SchemaType;
    data?: Record<string, any>;
    graph?: SchemaItem[];
}

const { type, data = {}, graph } = Astro.props;

let json: any;

if (graph && graph.length > 0) {
    json = buildGraph(graph);
} else if (type) {
    json = {
        "@context": "https://schema.org",
        "@graph": [buildSchema(type, data)].filter(
            (obj) => Object.keys(obj).length > 0,
        ),
    };
}
---

{json && <script is:inline type="application/ld+json" set:html={JSON.stringify(json)} />}
