---
import { siteConfig } from "../../config/site";
---

<!-- Hallmark · nav: N5 Floating pill — centered floating chip, not full-width sticky bar -->
<div class="fixed top-4 inset-x-0 z-50 flex justify-center px-4 pointer-events-none">
    <nav
        class="pointer-events-auto flex items-center gap-1 md:gap-2 bg-card/85 backdrop-blur-md border border-border rounded-full pl-3 pr-2 py-2 shadow-sm max-w-[min(100%,64rem)] w-full"
        aria-label="Główna nawigacja"
    >
        <!-- Logo -->
        <a
            href="/"
            aria-label="Studio Algorytm — strona główna"
            class="flex items-center gap-2 pr-2 md:pr-3 md:border-r md:border-border shrink-0"
        >
            <img src="/images/logo/logo-mark.svg" alt="" class="w-7 h-7" />
            <span class="font-serif text-lg font-medium text-foreground hidden sm:inline whitespace-nowrap">Studio Algorytm</span>
        </a>

        <!-- Desktop Menu -->
        <div class="hidden md:flex items-center gap-1 text-sm font-medium flex-1 justify-center">
            {
                siteConfig.navLinks.map((link) =>
                    link.children ? (
                        <div class="relative group">
                            {link.href ? (
                                <a
                                    href={link.href}
                                    class="px-3 py-2 rounded-full text-foreground/80 hover:text-primary hover:bg-muted transition-colors flex items-center gap-1 whitespace-nowrap"
                                >
                                    {link.text}
                                    <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                    </svg>
                                </a>
                            ) : (
                                <span class="px-3 py-2 rounded-full text-foreground/80 hover:text-primary hover:bg-muted transition-colors flex items-center gap-1 cursor-default whitespace-nowrap">
                                    {link.text}
                                    <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                    </svg>
                                </span>
                            )}
                            <div class="absolute top-full left-1/2 -translate-x-1/2 pt-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
                                <div class="bg-card border border-border rounded-2xl shadow-lg py-2 min-w-[260px]">
                                    {link.children.map((child) => (
                                        <a
                                            href={child.href}
                                            class="block px-4 py-2 text-sm text-foreground/80 hover:text-primary hover:bg-muted transition-colors rounded-xl mx-1 whitespace-nowrap"
                                        >
                                            {child.text}
                                        </a>
                                    ))}
                                </div>
                            </div>
                        </div>
                    ) : (
                        <a
                            href={link.href}
                            class="px-3 py-2 rounded-full text-foreground/80 hover:text-primary hover:bg-muted transition-colors whitespace-nowrap"
                        >
                            {link.text}
                        </a>
                    )
                )
            }
        </div>

        <!-- CTA (desktop) -->
        <a
            href="/kontakt"
            class="hidden md:inline-flex items-center bg-primary text-white px-4 py-2 rounded-full text-sm font-medium hover:bg-primary-ink transition-colors whitespace-nowrap shrink-0"
        >
            Darmowa wycena
        </a>

        <!-- Hamburger / Mobile Menu Button -->
        <button
            id="mobile-menu-button"
            class="md:hidden pointer-events-auto group p-2 -mr-1 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-full shrink-0"
            type="button"
            aria-controls="mobile-menu"
            aria-expanded="false"
            aria-label="Otwórz menu"
        >
            <div class="w-6 h-5 flex flex-col justify-between items-end">
                <span
                    class="w-full h-0.5 bg-foreground transition-all group-[[aria-expanded='true']]:rotate-45 group-[[aria-expanded='true']]:translate-y-[9px]"
                ></span>
                <span
                    class="w-4/5 h-0.5 bg-foreground transition-all group-[[aria-expanded='true']]:opacity-0"
                ></span>
                <span
                    class="w-full h-0.5 bg-foreground transition-all group-[[aria-expanded='true']]:-rotate-45 group-[[aria-expanded='true']]:-translate-y-[9px]"
                ></span>
            </div>
        </button>
    </nav>
</div>

<!-- Mobile Full-Screen Menu -->
<div
    id="mobile-menu"
    class="fixed inset-0 z-[45] bg-background text-foreground hidden flex-col items-center justify-center translate-x-full transition-transform duration-300"
>
    <div class="flex flex-col items-center gap-6 max-h-[80vh] overflow-y-auto px-6">
        {
            siteConfig.navLinks.map((link) =>
                link.children ? (
                    <div class="flex flex-col items-center gap-3">
                        <span class="text-3xl font-serif text-primary">
                            {link.text}
                        </span>
                        <div class="flex flex-col items-center gap-2">
                            {link.children.map((child) => (
                                <a
                                    href={child.href}
                                    class="text-lg text-muted-foreground hover:text-primary transition mobile-menu-link"
                                >
                                    {child.text}
                                </a>
                            ))}
                        </div>
                    </div>
                ) : (
                    <a
                        href={link.href}
                        class="text-3xl font-serif hover:text-primary transition mobile-menu-link"
                    >
                        {link.text}
                    </a>
                )
            )
        }
        <a
            href="/kontakt"
            class="mt-4 bg-primary text-white px-8 py-3 rounded-full text-lg font-medium mobile-menu-link"
        >
            Kontakt
        </a>
    </div>
</div>

<script>
    const button = document.getElementById("mobile-menu-button");
    const menu = document.getElementById("mobile-menu");

    function toggleMenu() {
        const isExpanded = button?.getAttribute("aria-expanded") === "true";
        if (isExpanded) {
            closeMenu();
        } else {
            openMenu();
        }
    }

    function openMenu() {
        menu?.classList.remove("hidden");
        requestAnimationFrame(() => {
            menu?.classList.remove("translate-x-full");
            menu?.classList.add("translate-x-0");
            menu?.classList.add("flex");
        });
        button?.setAttribute("aria-expanded", "true");
        document.body.style.overflow = "hidden";
    }

    function closeMenu() {
        menu?.classList.add("translate-x-full");
        menu?.classList.remove("translate-x-0");

        button?.setAttribute("aria-expanded", "false");
        document.body.style.overflow = "";

        setTimeout(() => {
            if (button?.getAttribute("aria-expanded") === "false") {
                menu?.classList.add("hidden");
                menu?.classList.remove("flex");
            }
        }, 300);
    }

    button?.addEventListener("click", toggleMenu);

    document.querySelectorAll(".mobile-menu-link").forEach((link) => {
        link.addEventListener("click", closeMenu);
    });
</script>
