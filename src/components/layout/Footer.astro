---
import { siteConfig } from "../../config/site";
import Form from "../ui/Form.astro";
---

<!-- Hallmark · footer: Ft6 Letter close — personal sign-off, not 4-column SaaS footer -->
<footer
    class="bg-primary text-white pt-24 pb-10 px-6 md:px-12 lg:px-24"
    id="contact"
>
    <div class="max-w-6xl mx-auto">
        <!-- Letter + form, asymmetric 7/5 -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 mb-20">
            <!-- Letter -->
            <div class="lg:col-span-7 reveal-on-scroll">
                <p class="font-serif text-2xl md:text-3xl leading-snug text-balance mb-8">
                    Masz pomysł na stronę, sklep albo potrzebujesz wsparcia SEO?
                    Napisz do nas — odpisujemy osobiście, bez agencyjnego szumu.
                </p>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 mb-10">
                    <div>
                        <p class="text-xs uppercase tracking-widest text-white/50 mb-2">Napisz</p>
                        <a
                            class="block text-lg border-b border-white/30 pb-1 hover:border-white transition-colors whitespace-nowrap"
                            href={`mailto:${siteConfig.email}`}
                        >
                            {siteConfig.email}
                        </a>
                        <p class="mt-3 text-white/70 whitespace-nowrap">{siteConfig.tel}</p>
                    </div>
                    <div>
                        <p class="text-xs uppercase tracking-widest text-white/50 mb-2">Wpadnij</p>
                        <p class="text-white/80 leading-relaxed">Bydgoszcz<br />ul. Sępia 4, Polska</p>
                    </div>
                </div>

                <p class="font-serif italic text-white/70 text-sm">
                    — Studio Algorytm, kolektyw trzech ekspertów
                </p>
            </div>

            <!-- Form -->
            <div class="lg:col-span-5 reveal-on-scroll">
                <div class="bg-white/5 p-6 md:p-8 rounded-2xl border border-white/10">
                    <Form formId="contact-form-footer" />
                </div>
            </div>
        </div>

        <!-- Bottom line — single inline row, not 4 columns -->
        <div
            class="border-t border-white/10 pt-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 text-sm text-white/60"
        >
            <p class="font-serif text-base text-white/90">{siteConfig.name}</p>
            <div class="flex items-center gap-4 text-xs">
                <span>&copy; {new Date().getFullYear()}</span>
                <a
                    class="underline hover:text-white transition whitespace-nowrap"
                    href="/polityka-prywatnosci">Polityka prywatności</a
                >
            </div>
        </div>
    </div>
</footer>
