---
import BaseLayout from "../layouts/BaseLayout.astro";
import Schema from "../components/seo/Schema.astro";
import { experts } from "../config/experts";
import { siteConfig } from "../config/site";

const metadata = {
    title: "Kontakt",
    description: "Skontaktuj się z nami, aby omówić Twój projekt B2B.",
};
const pageUrl = new URL(Astro.url.pathname, siteConfig.url).toString();
const schemaGraph = [
    { type: "ContactPage" as const, data: { url: pageUrl } },
];

---

<BaseLayout {metadata}>
    <Schema graph={schemaGraph} />
    <!-- Hallmark · kontakt: workbench — asymmetric, hairline rows, no eyebrow pills -->
    <section class="pt-36 md:pt-44 pb-24 px-6 md:px-12 lg:px-24">
        <div class="max-w-6xl mx-auto">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
                <!-- Left — heading + contact details -->
                <div class="lg:col-span-7 reveal-on-scroll">
                    <h1 class="font-serif text-4xl md:text-6xl lg:text-7xl leading-[1.05] mb-8 text-balance">
                        Porozmawiajmy o Twoim projekcie
                    </h1>
                    <p class="text-lg text-ink-soft max-w-md leading-relaxed mb-12">
                        Masz projekt? Potrzebujesz konsultacji? A może po prostu chcesz zapytać o możliwości współpracy? Napisz do nas.
                    </p>

                    <!-- Contact details — hairline rows, not 3 stacked blocks -->
                    <div class="border-t-2 border-foreground">
                        <div class="grid grid-cols-1 md:grid-cols-12 gap-4 py-6 border-b border-border-strong">
                            <p class="md:col-span-4 text-xs uppercase tracking-widest text-muted-foreground">Adres</p>
                            <p class="md:col-span-8 text-ink-soft">Bydgoszcz, ul. Sępia 4</p>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-12 gap-4 py-6 border-b border-border-strong">
                            <p class="md:col-span-4 text-xs uppercase tracking-widest text-muted-foreground">Telefon</p>
                            <p class="md:col-span-8 text-ink-soft tabular-nums">{siteConfig.tel}</p>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-12 gap-4 py-6 border-b border-border-strong">
                            <p class="md:col-span-4 text-xs uppercase tracking-widest text-muted-foreground">E-mail</p>
                            <div class="md:col-span-8 space-y-1.5">
                                <a class="block text-foreground border-b border-foreground/30 hover:border-foreground transition-colors w-fit" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
                                {experts.map((expert) => (
                                    <a class="block text-ink-soft hover:text-foreground transition-colors w-fit" href={`mailto:${expert.email}`}>
                                        {expert.email} — {expert.name}
                                    </a>
                                ))}
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right — map -->
                <div class="lg:col-span-5 reveal-on-scroll">
                    <div class="bg-card border border-border p-2 h-full min-h-[400px]">
                        <iframe
                            src="https://maps.google.com/maps?q=S%C4%99pia%204%2C%20Bydgoszcz&t=&z=15&ie=UTF8&iwloc=&output=embed"
                            width="100%"
                            height="100%"
                            style="border:0; min-height: 400px;"
                            allowfullscreen=""
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"
                            title="Mapa — Bydgoszcz, ul. Sępia 4"
                        ></iframe>
                    </div>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
