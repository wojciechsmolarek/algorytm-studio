---
import BaseLayout from "../layouts/BaseLayout.astro";

const metadata = {
    title: "404 — Strona nie znaleziona",
    description: "Strona, której szukasz, nie istnieje lub została przeniesiona.",
    ignoreTitleTemplate: true,
};
---

<BaseLayout {metadata}>
    <!-- Hallmark · 404: editorial, no gradient headline, Polish copy -->
    <section class="min-h-[70vh] flex items-center pt-36 pb-20 px-6 md:px-12 lg:px-24 bg-surface">
        <div class="max-w-3xl mx-auto w-full reveal-on-scroll">
            <p class="font-serif text-7xl md:text-9xl text-primary tabular-nums leading-none mb-6">404</p>
            <h1 class="font-serif text-3xl md:text-5xl leading-tight mb-6 text-balance">
                Tego adresu tu nie ma.
            </h1>
            <p class="text-lg text-ink-soft leading-relaxed mb-10 max-w-xl">
                Strona, której szukasz, mogła zostać przeniesiona, usunięta albo nigdy nie istniała. Spróbuj wrócić na stronę główną albo skontaktuj się z nami bezpośrednio.
            </p>
            <div class="flex flex-wrap gap-3">
                <a
                    href="/"
                    class="inline-flex items-center bg-primary text-white px-7 py-3.5 rounded-full font-medium hover:bg-primary-ink transition-colors whitespace-nowrap"
                >
                    Strona główna
                </a>
                <a
                    href="/kontakt"
                    class="inline-flex items-center text-foreground border border-border-strong px-7 py-3.5 rounded-full font-medium hover:bg-muted transition-colors whitespace-nowrap"
                >
                    Kontakt
                </a>
            </div>
        </div>
    </section>
</BaseLayout>
