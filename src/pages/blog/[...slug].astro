---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Schema from "../../components/seo/Schema.astro";
import CodeHighlighter from "../../components/CodeHighlighter.astro";

import { getCollection } from "astro:content";
import { siteConfig } from "../../config/site";

export async function getStaticPaths() {
    const blog = await getCollection("blog");
    return blog.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { title, description, pubDate, author, authorSlug, authorDescription, authorAvatar, authorRole, authorExpertise, authorPhoto, image, content } = post.data;

const formattedDate = pubDate.toLocaleDateString("pl-PL", {
    year: "numeric",
    month: "long",
    day: "numeric",
});

const metadata = {
    title: title,
    description: description,
    ogImage: image,
    ogType: "article",
    breadcrumbLabels: { [post.id]: title },
};

const pageUrl = new URL(Astro.url.pathname, siteConfig.url).toString();
const articleBody = content.replace(/<[^>]*>/g, "").trim();
const schemaGraph = [
    { type: "BlogPosting" as const, data: { title, description, image, pubDate, author, authorSlug, articleBody, url: pageUrl, tags: post.data.tags, category: post.data.category } },
];
---

<BaseLayout metadata={metadata}>
    <CodeHighlighter />
    <Schema graph={schemaGraph} />
    <section class="relative pt-36 md:pt-44 pb-20 px-6 md:px-12 lg:px-24">
        <div class="relative mx-auto max-w-3xl">
            <div class="mb-10">
                <p
                    class="text-xs uppercase tracking-widest text-primary font-medium mb-5"
                >
                    {formattedDate} • {authorSlug ? (
                        <a href={`/blog/autor/${authorSlug}`} class="hover:underline">{author}</a>
                    ) : author}
                </p>
                <h1
                    class="font-serif text-3xl md:text-5xl leading-[1.1] text-foreground text-balance"
                >
                    {title}
                </h1>
            </div>

            {
                image && (
                    <div class="relative mb-10 w-full overflow-hidden bg-muted">
                        <img
                            src={image}
                            alt={title}
                            class="w-full h-auto object-cover"
                        />
                    </div>
                )
            }

            <div
                class="prose prose-lg dark:prose-invert mx-auto max-w-none prose-headings:font-serif prose-headings:text-foreground prose-a:text-primary hover:prose-a:underline prose-p:text-ink-soft prose-strong:text-foreground prose-li:text-ink-soft"
                set:html={content}
            />

            {/* Author Bio — hairline rule, not boxed card */}
            <section class="mt-16 pt-8 border-t-2 border-foreground flex flex-col md:flex-row gap-8 items-center md:items-start">
                <div class="w-28 h-28 flex-shrink-0 overflow-hidden bg-muted">
                    {authorPhoto ? (
                        <img
                            src={authorPhoto}
                            alt={author}
                            width={128}
                            height={128}
                            loading="lazy"
                            decoding="async"
                            class="w-full h-full object-cover"
                        />
                    ) : authorAvatar ? (
                        <img
                            src={authorAvatar}
                            alt={author}
                            width={128}
                            height={128}
                            loading="lazy"
                            decoding="async"
                            class="w-full h-full object-cover"
                        />
                    ) : (
                        <div class="w-full h-full bg-primary flex items-center justify-center text-white font-bold text-4xl">
                            {author.charAt(0).toUpperCase()}
                        </div>
                    )}
                </div>
                <div class="text-center md:text-left">
                    <h4 class="font-serif text-xl md:text-2xl font-medium mb-2 text-foreground">
                        O autorze: {authorSlug ? (
                            <a href={`/blog/autor/${authorSlug}`} class="text-primary hover:underline">{author}</a>
                        ) : author}
                    </h4>
                    {authorRole && (
                        <p class="text-xs uppercase tracking-widest text-primary font-medium mb-3">{authorRole}</p>
                    )}
                    {authorExpertise && (
                        <p class="text-base text-ink-soft mb-4 leading-relaxed">{authorExpertise}</p>
                    )}
                    {authorDescription && (
                        <p class="text-sm text-ink-soft leading-relaxed">{authorDescription}</p>
                    )}
                    {authorSlug && (
                        <a href={`/blog/autor/${authorSlug}`} class="inline-flex items-center gap-2 text-foreground border-b border-foreground/30 hover:border-foreground font-medium text-sm mt-4 transition-colors">
                            Zobacz wszystkie artykuły autora
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path d="M9 5l7 7-7 7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </a>
                    )}
                </div>
            </section>
        </div>
    </section>

    <script>
        document.querySelectorAll('.prose table').forEach((table) => {
            if (table.closest('figure.wp-block-table') || table.closest('.table-scroll-wrapper')) return;
            const wrapper = document.createElement('div');
            wrapper.className = 'table-scroll-wrapper';
            table.parentNode?.insertBefore(wrapper, table);
            wrapper.appendChild(table);
        });
    </script>
</BaseLayout>
