---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config/site";
import { experts } from "../config/experts";
import { services } from "../config/services";

import HeroSection from "../components/sections/HeroSection.astro";
import ExpertsSection from "../components/sections/ExpertsSection.astro";
import WhyUsSection from "../components/sections/WhyUsSection.astro";
import ServicesSection from "../components/sections/ServicesSection.astro";
import StrategySection from "../components/sections/StrategySection.astro";
const metadata = {
	title: `${siteConfig.name} — Wspólnie budujemy widoczność`,
	description: siteConfig.description,
	ignoreTitleTemplate: true,
};

const strategyColumns = [
	{
		title: "Od lokalnych liderów po globalnych graczy.",
		description:
			'Swobodnie poruszamy się w realiach małych, lokalnych przedsiębiorstw, jak i dużych globalnych graczy. Rozumiemy różnice w dynamice pracy i wiemy, jak efektywnie lokować budżety marketingowe o każdej skali.',
	},
	{
		title: "Design wspierający sprzedaż.",
		description:
			'Nowoczesna strona WWW musi być przedłużeniem Twojego działu sprzedaży. Projektujemy interfejsy, które <strong class="text-foreground font-semibold">skracają drogę</strong> od pierwszego kontaktu do zapytania ofertowego.',
	},
	{
		title: "Technologia i bezpieczeństwo.",
		description:
			'Migracja serwisu czy stałe utrzymanie to fundament bezpieczeństwa. Jako kolektyw specjalistów bierzemy pełną odpowiedzialność za <strong class="text-foreground font-semibold">technologiczną stronę</strong> Twojego biznesu.',
	},
];

---

<BaseLayout {metadata}>
	<HeroSection
		title='Kolektyw 3 ekspertów SEO i web dev. <span class="italic text-primary">Bez agencyjnego szumu.</span>'
		subtitle="Jesteśmy kolektywem, nie agencją. Trzech specjalistów: SEO, web development i UX. Żadnych pośredników, żadnych project managerów — tylko ludzie, którzy realnie wykonują pracę."
		primaryCta={{ text: "Porozmawiajmy", href: "#contact" }}
		secondaryCta={{ text: "Nasze usługi", href: "#services" }}
		image={{
			src: "https://lh3.googleusercontent.com/aida-public/AB6AXuCFbbybPfNH6l8i7ZW20gdulyIwfECJERXK2i1lWCXp5hmRVONaKuwzbOY5FoQ3VNLt4RkCGXH3vQmL4iYnLNj8p8b2ak9qM_YRKDYRh8JdRVpfwWCNxxccMhcRzxCkt00ecg2TlOUchKPmWVY3ZAV3h3F9UDV9UGXBGphWB-qFC-41tT2iwMkTus2eXYikVJjPjsfuazmgf_4FLxyAcC8ZBnlUyPw0o5kYDWslI75aI2_hKlnGFG9Xxlj5TIVrh5chBIUkXmm3ykV5",
			alt: "B2B Collective Founders",
		}}
	/>


	<ExpertsSection experts={experts} />

	<WhyUsSection
		tagline="Dlaczego My?"
		headline="Bez pośredników. <br/>Bez project managerów. <br/><span class='text-primary'>Transparentne działania.</span> <br/>Głębsze zrozumienie B2B."
		description="Eliminujemy szum komunikacyjny. Rozmawiasz bezpośrednio z osobami, które wykonują pracę. To gwarantuje jakość i szybkość wdrażania zmian."
	/>

	<ServicesSection services={services} />

	<StrategySection
		headline="Strategiczne podejście do B2B"
		columns={strategyColumns}
	/>
</BaseLayout>
