---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config/site";
import { experts } from "../config/experts";
import { services } from "../config/services";

import HeroSection from "../components/sections/HeroSection.astro";
import ExpertsSection from "../components/sections/ExpertsSection.astro";
import WhyUsSection from "../components/sections/WhyUsSection.astro";
import ServicesSection from "../components/sections/ServicesSection.astro";
import StrategySection from "../components/sections/StrategySection.astro";
const metadata = {
	title: `${siteConfig.name} — Wspólnie budujemy widoczność`,
	description: siteConfig.description,
	ignoreTitleTemplate: true,
};

const strategyColumns = [
	{
		title: "B2B ma dłuższy cykl i wyższą wartość transakcji.",
		description:
			'W B2B decyzja zapada tygodniami lub miesiącami, a w grę wchodzi kilkudziesięcio- lub kilkusettysięczna umowa. Strona i SEO muszą wspierać ten cykl — od pierwszego zapytania, przez research zespołu, po decyzję decydenta.',
	},
	{
		title: "Design przedłużający dział sprzedaży.",
		description:
			'Strona WWW powinna skracać drogę od pierwszego kontaktu do zapytania ofertowego. Projektujemy interfejsy, które <strong class="text-foreground font-semibold">prowadzą leada</strong> przez argumenty, dowody i CTA — nie wystarczą ładne grafiki.',
	},
	{
		title: "Migracje bez utraty pozycji, monitoring na żywo.",
		description:
			'Przekierowania 301, canonical, mapa linkowania wewnętrznego — jeden błąd przy migracji i miesiące odbudowywania widoczności. Przejmujemy <strong class="text-foreground font-semibold">technologiczną stronę</strong> projektu i monitorujemy GSC, zanim cokolwiek zacznie spadać.',
	},
];

---

<BaseLayout {metadata}>
	<HeroSection
		title='Kolektyw 3 ekspertów SEO i web dev. Bez agencyjnego szumu.'
		subtitle="Jesteśmy kolektywem trzech specjalistów: SEO, web development i UX. Rozmawiasz bezpośrednio z osobami, które wykonują pracę — bez pośredników i project managerów."
		primaryCta={{ text: "Porozmawiajmy", href: "#contact" }}
		secondaryCta={{ text: "Nasze usługi", href: "#services" }}
	/>

	<ExpertsSection experts={experts} />

	<WhyUsSection
		tagline="Dlaczego my"
		headline="Rozmawiasz z ludźmi, którzy robią pracę. Transparentne działania i głębsze zrozumienie B2B."
		description="Eliminujemy szum komunikacyjny. Rozmawiasz bezpośrednio z osobami, które wykonują pracę. To gwarantuje jakość i szybkość wdrażania zmian."
	/>

	<ServicesSection services={services} />

	<StrategySection
		headline="Jak pracujemy z B2B"
		columns={strategyColumns}
	/>
</BaseLayout>
