---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Schema from "../../components/seo/Schema.astro";
import { siteConfig } from "../../config/site";

const metadata = {
    title: "Migracje stron i sklepów internetowych",
    description: "Bezpieczna migracja strony lub sklepu internetowego bez utraty widoczności w Google. Pełny nadzór nad procesem przenoszenia serwisu.",
};

const processSteps = [
    {
        num: "01",
        title: "Audyt przed-migracyjny",
        description: "Inwentaryzacja wszystkich URL-i, analiza profilu linków, mapowanie przekierowań 1:1, identyfikacja kluczowych podstron generujących ruch organiczny.",
    },
    {
        num: "02",
        title: "Plan migracji",
        description: "Szczegółowy plan działania z harmonogramem, checklistami i scenariuszami awaryjnymi. Każdy etap jest udokumentowany i zatwierdzony.",
    },
    {
        num: "03",
        title: "Wdrożenie i monitoring",
        description: "Nadzór nad wdrożeniem, testy przekierowań, walidacja danych strukturalnych. Po migracji - monitoring widoczności i szybka reakcja na problemy.",
    },
];

const risks = [
    {
        title: "Utrata ruchu organicznego",
        description: "Bez prawidłowych przekierowań 301 tracisz cały autorytet zgromadzony przez lata. Jedna pomyłka może kosztować miesiące odbudowy.",
    },
    {
        title: "Zepsute linkowanie wewnętrzne",
        description: "Nowa struktura URL bez mapy przekierowań prowadzi do błędów 404, frustracji użytkowników i spadku pozycji w wynikach wyszukiwania.",
    },
    {
        title: "Utrata danych strukturalnych",
        description: "Schema.org, Open Graph, meta tagi - ich brak po migracji oznacza gorsze wyświetlanie w wynikach i spadek CTR.",
    },
    {
        title: "Problemy z indeksowaniem",
        description: "Błędna konfiguracja robots.txt lub sitemap.xml na nowej stronie może zablokować Google przed indeksowaniem Twoich treści.",
    },
];

const types = [
    {
        title: "Zmiana domeny",
        description: "Przeniesienie serwisu na nową domenę z zachowaniem całego autorytetu i pozycji w wynikach wyszukiwania.",
    },
    {
        title: "Zmiana CMS / platformy",
        description: "Migracja z WordPressa, Shopify, Magento lub innych platform na nowe rozwiązanie technologiczne.",
    },
    {
        title: "Zmiana struktury URL",
        description: "Reorganizacja architektury informacji i struktury linków bez utraty dotychczasowej widoczności.",
    },
    {
        title: "Łączenie domen",
        description: "Konsolidacja wielu serwisów pod jedną domeną z prawidłowym transferem autorytetu i ruchu.",
    },
    {
        title: "Migracja HTTP na HTTPS",
        description: "Bezpieczne przejście na protokół HTTPS z pełnym zachowaniem pozycji i uniknięciem mixed content.",
    },
    {
        title: "Redesign strony",
        description: "Nadzór SEO nad procesem redesignu, by nowy wygląd nie oznaczał nowych problemów z widocznością.",
    },
];
const pageUrl = new URL(Astro.url.pathname, siteConfig.url).toString();
const schemaGraph = [
    { type: "Service" as const, data: { title: metadata.title, description: metadata.description, url: pageUrl } },
];

---

<BaseLayout {metadata}>
    <Schema graph={schemaGraph} />
    <!-- Hallmark · oferta: long-document macro — hairline rows, no eyebrow pills, no 3-col cards -->

    <!-- Hero — asymmetric, no eyebrow pill, no accent-emphasis word in H1 -->
    <section class="pt-36 md:pt-44 pb-20 px-6 md:px-12 lg:px-24 bg-surface">
        <div class="max-w-6xl mx-auto">
            <div class="reveal-on-scroll max-w-3xl">
                <h1 class="font-serif text-4xl md:text-6xl lg:text-7xl leading-[1.05] mb-8 text-balance">
                    Migracje stron i sklepów
                </h1>
                <p class="text-xl text-foreground leading-relaxed mb-4 max-w-2xl">
                    Źle przeprowadzona migracja to najczęstszy powód katastrofalnych spadków widoczności.
                </p>
                <p class="text-lg text-ink-soft leading-relaxed max-w-2xl">
                    Nadzorujemy cały proces, by Twoja strona nie straciła ani jednej pozycji.
                </p>
            </div>
        </div>
    </section>

    <!-- Risks — hairline rows, not 2-col cards -->
    <section class="py-20 md:py-24 px-6 md:px-12 lg:px-24">
        <div class="max-w-6xl mx-auto">
            <div class="mb-12 reveal-on-scroll max-w-3xl">
                <h2 class="font-serif text-2xl md:text-4xl leading-tight text-balance">
                    Dlaczego migracje są ryzykowne?
                </h2>
            </div>
            <div class="border-t-2 border-foreground">
                {risks.map((risk) => (
                    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 py-7 md:py-8 border-b border-border-strong reveal-on-scroll">
                        <div class="md:col-span-5">
                            <p class="text-lg font-medium text-foreground">{risk.title}</p>
                        </div>
                        <div class="md:col-span-7">
                            <p class="text-base text-ink-soft leading-relaxed">{risk.description}</p>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Process — genuinely numbered, hairline rows with ordinal -->
    <section class="py-20 md:py-24 px-6 md:px-12 lg:px-24 bg-surface">
        <div class="max-w-6xl mx-auto">
            <div class="mb-12 reveal-on-scroll max-w-3xl">
                <h2 class="font-serif text-2xl md:text-4xl leading-tight text-balance">
                    Nasz proces
                </h2>
            </div>
            <div class="border-t-2 border-foreground">
                {processSteps.map((step) => (
                    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 py-8 md:py-10 border-b border-border-strong reveal-on-scroll">
                        <div class="md:col-span-2">
                            <span class="font-serif text-3xl text-primary tabular-nums">{step.num}</span>
                        </div>
                        <div class="md:col-span-10">
                            <h3 class="font-serif text-xl md:text-2xl text-foreground mb-2">{step.title}</h3>
                            <p class="text-base text-ink-soft leading-relaxed">{step.description}</p>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Migration Types — 2-col asymmetric, not 3-col cards -->
    <section class="py-20 md:py-24 px-6 md:px-12 lg:px-24">
        <div class="max-w-6xl mx-auto">
            <div class="mb-12 reveal-on-scroll max-w-3xl">
                <h2 class="font-serif text-2xl md:text-4xl leading-tight text-balance">
                    Jakie migracje realizujemy?
                </h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10">
                {types.map((type) => (
                    <div class="border-t border-border-strong pt-5 reveal-on-scroll">
                        <h3 class="font-serif text-lg md:text-xl text-foreground mb-2">{type.title}</h3>
                        <p class="text-base text-ink-soft leading-relaxed">{type.description}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- CTA — letter-style, not bg-primary rounded-3xl card -->
    <section class="py-20 md:py-28 px-6 md:px-12 lg:px-24 bg-surface">
        <div class="max-w-3xl mx-auto text-center reveal-on-scroll">
            <h2 class="font-serif text-3xl md:text-5xl leading-tight mb-6 text-balance">
                Planujesz migrację?
            </h2>
            <p class="text-lg text-ink-soft leading-relaxed mb-10 max-w-xl mx-auto">
                Porozmawiajmy zanim zaczniesz. Prawidłowe przygotowanie to klucz do bezpiecznej migracji bez strat w widoczności.
            </p>
            <a
                class="inline-flex items-center bg-primary text-white px-7 py-3.5 rounded-full font-medium hover:bg-primary-ink transition-colors whitespace-nowrap"
                href="/kontakt"
            >
                Skonsultuj migrację
            </a>
        </div>
    </section>
</BaseLayout>
