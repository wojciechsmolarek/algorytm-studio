---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Schema from "../../components/seo/Schema.astro";
import { siteConfig } from "../../config/site";

const metadata = {
    title: "Konsultacje SEO na godziny",
    description:
        "Elastyczne konsultacje SEO z doświadczonym ekspertem. Konkretna odpowiedź na Twój problem SEO — bez długoterminowych umów, bez bullshitu.",
};

const triggers = [
    {
        title: "Masz konkretne pytanie, ale nie potrzebujesz agencji",
        description:
            "Strategia contentu, dobór słów kluczowych, ocena konkurencji — wystarczy jedna rozmowa z ekspertem, żeby ruszyć do przodu.",
    },
    {
        title: "Chcesz ocenić pracę obecnej agencji lub freelancera",
        description:
            "Second opinion od niezależnego eksperta, który nie ma interesu w podtrzymaniu umowy. Mówimy wprost co działa, a co to strata budżetu.",
    },
    {
        title: "Planujesz migrację lub redesign strony",
        description:
            "Jedna godzina konsultacji przed migracją może zaoszczędzić miesięcy odbudowywania pozycji. Sprawdzamy plan i wskazujemy ryzyka.",
    },
    {
        title: "Masz wewnętrzny zespół SEO, który utknął na problemie",
        description:
            "Twoi specjaliści wiedzą dużo, ale potrzebują eksperta od wąskiego zagadnienia. Dołączamy się na godzinę jako wsparcie, nie zastępstwo.",
    },
];

const packages = [
    {
        name: "Pojedyncza sesja",
        hours: "1–2 godz.",
        best: "Konkretny problem, quick win, ocena strategii",
        includes: [
            "Sesja online (Zoom/Meet/Teams)",
            "Pisemne podsumowanie po sesji",
            "Lista priorytetowych działań",
        ],
    },
    {
        name: "Pakiet strategiczny",
        hours: "5 godz.",
        best: "Audyt + strategia + sesja z zespołem",
        includes: [
            "Elastyczne wykorzystanie w ciągu 60 dni",
            "Pisemne podsumowanie po każdej sesji",
            "Priorytetyzowana lista zadań",
            "Dostęp do eksperta na czacie między sesjami",
        ],
    },
    {
        name: "Wsparcie stałe",
        hours: "10 godz. / miesiąc",
        best: "Nadzór nad wewnętrznym zespołem SEO",
        includes: [
            "Miesięczna pula godzin (bez przenoszenia)",
            "Priorytetowy dostęp — odpowiedź w 4h",
            "Przegląd raportów i wyników co miesiąc",
            "Nieograniczone pytania na czacie",
        ],
    },
];

const howItWorks = [
    {
        num: "01",
        title: "Wypełniasz brief",
        time: "5 minut",
        description:
            "Krótki formularz z opisem problemu lub pytań. Dzięki temu ekspert przygotowuje się przed rozmową — nie tracisz czasu na wprowadzenie.",
    },
    {
        num: "02",
        title: "Rezerwujesz termin",
        time: "do 48h",
        description:
            "Sesja online w Twoim kalendarzu. Możesz zaprosić cały zespół — developerów, content managerów, analityków.",
    },
    {
        num: "03",
        title: "Rozmawiasz z ekspertem",
        time: "umówiony czas",
        description:
            "Konkretna rozmowa bez lania wody. Analizujemy Twoją stronę na żywo, odpowiadamy na pytania, proponujemy rozwiązania.",
    },
    {
        num: "04",
        title: "Dostajesz podsumowanie",
        time: "do 24h po sesji",
        description:
            "Pisemny raport z najważniejszymi wnioskami i listą działań posortowaną priorytetowo. Coś, co możesz od razu przekazać zespołowi.",
    },
];

const topics = [
    "Audyty techniczne SEO",
    "Strategia słów kluczowych",
    "Analiza konkurencji",
    "Optymalizacja treści",
    "Link building strategy",
    "Migracje i redesign",
    "Core Web Vitals",
    "Analityka i raportowanie",
    "SEO lokalne",
    "Szkolenia zespołu",
    "International SEO",
    "E-commerce SEO",
];

const faqs = [
    {
        question: "Ile kosztuje godzina konsultacji?",
        answer: "Stawka za godzinę konsultacji wynosi 400–600 PLN netto, zależnie od tematyki i poziomu przygotowania materiałów. Pakiet 5h i 10h/miesiąc rozliczamy w stałej stawce — szczegóły podajemy przy wycenie. Pierwsza 30-minutowa rozmowa wstępna jest bezpłatna.",
    },
    {
        question: "Czy muszę się do czegoś przygotować?",
        answer: "Prosimy o krótki brief przed sesją (dostęp do GSC, GA4, adres strony, opis problemu). Im więcej wiemy przed rozmową, tym więcej zdążymy omówić w umówionym czasie. Szablon briefa wysyłamy po rezerwacji.",
    },
    {
        question: "Co zdążymy omówić w jedną godzinę?",
        answer: "W 60 minut jesteśmy w stanie np. ocenić strategię contentu dla jednej kategorii, przeprowadzić szybki przegląd techniczny i wskazać 3–5 priorytetowych zmian, lub omówić plan migracji domeny. Jeśli masz kilka tematów, rekomendujemy pakiet 2–3 godzin.",
    },
    {
        question: "Czy konsultacje są poufne?",
        answer: "Tak. Na życzenie podpisujemy NDA przed sesją. Nie udostępniamy danych Twojej strony ani informacji o projekcie osobom trzecim.",
    },
    {
        question: "Czy mogę zaprosić na sesję swój zespół deweloperski lub agencję?",
        answer: "Oczywiście — zachęcamy do tego. Wspólna sesja z deweloperem, content managerem lub zewnętrzną agencją jest często dużo bardziej efektywna niż relacjonowanie wniosków po fakcie.",
    },
    {
        question: "Czy godziny z pakietu można przenosić na kolejny miesiąc?",
        answer: "W pakiecie strategicznym (5h) godziny są ważne 60 dni. W pakiecie stałym (10h/miesiąc) godziny nie przechodzą na kolejny miesiąc — model subskrypcyjny zakłada regularne korzystanie z ekspertyzy.",
    },
];
const pageUrl = new URL(Astro.url.pathname, siteConfig.url).toString();
const schemaGraph = [
    { type: "Service" as const, data: { title: metadata.title, description: metadata.description, url: pageUrl } },
    { type: "FAQPage" as const, data: { url: pageUrl, faqs } },
];

---

<BaseLayout {metadata}>
    <Schema graph={schemaGraph} />
    <!-- Hallmark · oferta: long-document macro — hairline rows, no eyebrow pills, no 3-col cards -->

    <!-- Hero — asymmetric, no eyebrow pill, no accent-emphasis word in H1 -->
    <section class="pt-36 md:pt-44 pb-20 px-6 md:px-12 lg:px-24 bg-surface">
        <div class="max-w-6xl mx-auto">
            <div class="reveal-on-scroll max-w-3xl">
                <h1 class="font-serif text-4xl md:text-6xl lg:text-7xl leading-[1.05] mb-8 text-balance">
                    Konsultacje SEO "na godziny"
                </h1>
                <p class="text-xl text-foreground leading-relaxed mb-4 max-w-2xl">
                    Masz konkretne pytanie SEO i chcesz jasnej odpowiedzi — bez 3-miesięcznej umowy.
                </p>
                <p class="text-lg text-ink-soft leading-relaxed max-w-2xl">
                    Rezerwujesz czas eksperta dokładnie wtedy, kiedy go potrzebujesz. Płacisz tylko za godziny, które realnie wykorzystasz. Po każdej sesji dostajesz pisemne podsumowanie z listą działań.
                </p>
            </div>
        </div>
    </section>

    <!-- Triggers — hairline rows, not 2-col cards -->
    <section class="py-20 md:py-24 px-6 md:px-12 lg:px-24">
        <div class="max-w-6xl mx-auto">
            <div class="mb-12 reveal-on-scroll max-w-3xl">
                <h2 class="font-serif text-2xl md:text-4xl leading-tight text-balance">
                    Kiedy konsultacja ma sens
                </h2>
            </div>
            <div class="border-t-2 border-foreground">
                {triggers.map((item) => (
                    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 py-7 md:py-8 border-b border-border-strong reveal-on-scroll">
                        <div class="md:col-span-5">
                            <p class="text-lg font-medium text-foreground">{item.title}</p>
                        </div>
                        <div class="md:col-span-7">
                            <p class="text-base text-ink-soft leading-relaxed">{item.description}</p>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Packages — de-templated cards, no rounded-3xl, no hover lift -->
    <section class="py-20 md:py-24 px-6 md:px-12 lg:px-24 bg-surface">
        <div class="max-w-6xl mx-auto">
            <div class="mb-12 reveal-on-scroll max-w-3xl">
                <h2 class="font-serif text-2xl md:text-4xl leading-tight text-balance">
                    Wybierz zakres dopasowany do potrzeb
                </h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                {packages.map((pkg, i) => (
                    <div class={`bg-card border border-border p-7 rounded-lg reveal-on-scroll ${i === 1 ? "ring-2 ring-primary" : ""}`}>
                        <p class="text-sm uppercase tracking-widest text-primary font-medium mb-4">{pkg.name}</p>
                        <p class="font-serif text-4xl mb-2 text-foreground tabular-nums">{pkg.hours}</p>
                        <p class="text-sm text-ink-soft mb-8 border-b border-border pb-8">{pkg.best}</p>
                        <ul class="space-y-3">
                            {pkg.includes.map((item) => (
                                <li class="flex items-start gap-3 text-sm text-ink-soft">
                                    <span class="w-1.5 h-1.5 rounded-full bg-accent shrink-0 mt-1.5"></span>
                                    {item}
                                </li>
                            ))}
                        </ul>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- How it works — genuinely numbered, hairline rows with ordinal -->
    <section class="py-20 md:py-24 px-6 md:px-12 lg:px-24">
        <div class="max-w-6xl mx-auto">
            <div class="mb-12 reveal-on-scroll max-w-3xl">
                <h2 class="font-serif text-2xl md:text-4xl leading-tight text-balance mb-3">
                    Od rezerwacji do listy działań
                </h2>
                <p class="text-ink-soft">Cztery etapy, od briefu po raport.</p>
            </div>
            <div class="border-t-2 border-foreground">
                {howItWorks.map((step) => (
                    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 py-8 md:py-10 border-b border-border-strong reveal-on-scroll">
                        <div class="md:col-span-2">
                            <span class="font-serif text-3xl text-primary tabular-nums">{step.num}</span>
                        </div>
                        <div class="md:col-span-7">
                            <h3 class="font-serif text-xl md:text-2xl text-foreground mb-2">{step.title}</h3>
                            <p class="text-base text-ink-soft leading-relaxed">{step.description}</p>
                        </div>
                        <div class="md:col-span-3 md:text-right">
                            <span class="text-xs uppercase tracking-widest text-muted-foreground">{step.time}</span>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Topics — simple grid of bordered chips, left-aligned, no rounded-2xl -->
    <section class="py-20 md:py-24 px-6 md:px-12 lg:px-24 bg-surface">
        <div class="max-w-6xl mx-auto">
            <div class="mb-12 reveal-on-scroll max-w-3xl">
                <h2 class="font-serif text-2xl md:text-4xl leading-tight text-balance">
                    O czym możemy porozmawiać?
                </h2>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 reveal-on-scroll">
                {topics.map((topic) => (
                    <div class="bg-card border border-border rounded-none px-5 py-4 text-sm text-ink-soft hover:text-primary hover:border-primary transition-colors text-left">
                        {topic}
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Social Proof — stats as columns with hairline top, not 3 cards -->
    <section class="py-20 md:py-24 px-6 md:px-12 lg:px-24">
        <div class="max-w-6xl mx-auto">
            <div class="mb-12 reveal-on-scroll max-w-3xl">
                <h2 class="font-serif text-2xl md:text-4xl leading-tight text-balance">
                    Co mówią klienci po sesjach
                </h2>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 mb-12 reveal-on-scroll">
                <div class="border-t-2 border-foreground pt-5">
                    <p class="font-serif text-4xl md:text-5xl text-primary mb-2 tabular-nums">200+</p>
                    <p class="text-sm text-ink-soft leading-relaxed">przeprowadzonych sesji konsultacyjnych dla firm z branży B2B, e-commerce i SaaS</p>
                </div>
                <div class="border-t-2 border-foreground pt-5">
                    <p class="font-serif text-4xl md:text-5xl text-primary mb-2 tabular-nums">94%</p>
                    <p class="text-sm text-ink-soft leading-relaxed">klientów wraca po kolejne godziny lub przechodzi na stałą współpracę w ciągu 3 miesięcy</p>
                </div>
                <div class="border-t-2 border-foreground pt-5">
                    <p class="font-serif text-4xl md:text-5xl text-primary mb-2 tabular-nums">48h</p>
                    <p class="text-sm text-ink-soft leading-relaxed">średni czas od zgłoszenia do pierwszej sesji — bez tygodni czekania na onboarding</p>
                </div>
            </div>

            <!-- Testimonial — blockquote, no boxed card -->
            <blockquote class="max-w-3xl reveal-on-scroll border-l-2 border-foreground pl-6">
                <p class="text-xl md:text-2xl font-serif leading-relaxed mb-5 text-balance">
                    "Jedna 2-godzinna sesja przed migracją na nowy CMS oszczędziła nam prawdopodobnie kilku miesięcy odbudowywania widoczności. Lista kontrolna, którą dostaliśmy po spotkaniu, była warta wielokrotnie więcej niż koszt konsultacji."
                </p>
                <footer class="text-sm text-muted-foreground">
                    <strong class="text-foreground">Marek Wiśniewski</strong> — Head of Marketing, sklep z branży home & decor
                </footer>
            </blockquote>
        </div>
    </section>

    <!-- FAQ — hairline rows, not stacked cards -->
    <section class="py-20 md:py-24 px-6 md:px-12 lg:px-24 bg-surface">
        <div class="max-w-6xl mx-auto">
            <div class="mb-12 reveal-on-scroll max-w-3xl">
                <h2 class="font-serif text-2xl md:text-4xl leading-tight text-balance">
                    Pytania, które słyszymy najczęściej
                </h2>
            </div>
            <div class="border-t-2 border-foreground">
                {faqs.map((faq) => (
                    <details class="border-b border-border-strong reveal-on-scroll group">
                        <summary class="flex items-center justify-between gap-4 py-6 cursor-pointer list-none">
                            <h3 class="text-lg font-medium text-foreground">{faq.question}</h3>
                            <span class="text-primary text-xl shrink-0 group-open:rotate-45 transition-transform">+</span>
                        </summary>
                        <p class="text-base text-ink-soft leading-relaxed pb-6 pr-8">{faq.answer}</p>
                    </details>
                ))}
            </div>
        </div>
    </section>

    <!-- Prepaid SEO — de-templated, hairline rows on the right -->
    <section class="py-20 md:py-24 px-6 md:px-12 lg:px-24">
        <div class="max-w-6xl mx-auto">
            <div class="mb-12 reveal-on-scroll max-w-3xl">
                <h2 class="font-serif text-2xl md:text-4xl leading-tight text-balance">
                    Konsultacje to dobry start. Pre-paid SEO to ciągłość.
                </h2>
            </div>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
                <div class="border-t-2 border-foreground pt-6 reveal-on-scroll">
                    <p class="text-ink-soft leading-relaxed mb-6">
                        Wielu klientów zaczyna od jednej sesji konsultacyjnej, a po kilku tygodniach wraca z potrzebą regularnego wsparcia. Model pre-paid SEO to odpowiedź na to zapotrzebowanie — kupujesz pakiet godzin z góry i korzystasz z eksperta dokładnie wtedy i na to, co jest aktualnie najważniejsze.
                    </p>
                    <p class="text-ink-soft leading-relaxed mb-8">
                        Bez umów rocznych. Bez narzuconego zakresu. Bez płacenia za "abonament" w miesiącach, gdy nic nie potrzebujesz.
                    </p>
                    <a
                        href="/oferta/seo-pre-paid"
                        class="inline-flex items-center bg-primary text-white px-7 py-3.5 rounded-full font-medium hover:bg-primary-ink transition-colors whitespace-nowrap"
                    >
                        Zobacz model pre-paid →
                    </a>
                </div>
                <div class="reveal-on-scroll">
                    <div class="border-t border-border-strong pt-5 pb-5">
                        <h3 class="font-medium text-foreground mb-2">Pełna kontrola budżetu</h3>
                        <p class="text-ink-soft text-sm leading-relaxed">Wiesz dokładnie ile wydajesz i na co. Każda godzina jest udokumentowana w raporcie zadań.</p>
                    </div>
                    <div class="border-t border-border-strong pt-5 pb-5">
                        <h3 class="font-medium text-foreground mb-2">Ty ustalasz priorytety</h3>
                        <p class="text-ink-soft text-sm leading-relaxed">Dziś audyt techniczny, w przyszłym miesiącu optymalizacja treści — elastyczny zakres bez narzuconych szablonów.</p>
                    </div>
                    <div class="border-t border-border-strong pt-5 pb-5">
                        <h3 class="font-medium text-foreground mb-2">Skalujesz kiedy chcesz</h3>
                        <p class="text-ink-soft text-sm leading-relaxed">Pakiety od 10 do 80 godzin miesięcznie. Zwiększasz lub zmniejszasz zakres bez konieczności aneksowania umowy.</p>
                    </div>
                    <div class="border-t border-b border-border-strong pt-5 pb-5">
                        <h3 class="font-medium text-foreground mb-2">Kończysz kiedy chcesz</h3>
                        <p class="text-ink-soft text-sm leading-relaxed">Żadnych kar za rezygnację. Płacisz za kolejny pakiet tylko wtedy, gdy jesteś zadowolony z efektów.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA — letter-style, not bg-primary rounded-3xl card -->
    <section class="py-20 md:py-28 px-6 md:px-12 lg:px-24 bg-surface">
        <div class="max-w-3xl mx-auto text-center reveal-on-scroll">
            <h2 class="font-serif text-3xl md:text-5xl leading-tight mb-6 text-balance">
                Pierwsza rozmowa jest bezpłatna.
            </h2>
            <p class="text-lg text-ink-soft leading-relaxed mb-10 max-w-xl mx-auto">
                Napisz nam w czym możemy pomóc. Odezwiemy się w ciągu 24 godzin, żeby umówić 30-minutową rozmowę wstępną — zupełnie bez zobowiązań.
            </p>
            <ul class="space-y-3 text-ink-soft mb-10 max-w-md mx-auto text-left">
                <li class="flex items-center gap-3">
                    <span class="w-1.5 h-1.5 rounded-full bg-accent shrink-0"></span>
                    Odpowiedź w 24h w dni robocze
                </li>
                <li class="flex items-center gap-3">
                    <span class="w-1.5 h-1.5 rounded-full bg-accent shrink-0"></span>
                    30 minut rozmowy wstępnej — bezpłatnie
                </li>
                <li class="flex items-center gap-3">
                    <span class="w-1.5 h-1.5 rounded-full bg-accent shrink-0"></span>
                    NDA na życzenie przed pierwszą sesją
                </li>
            </ul>
            <a class="inline-flex items-center bg-primary text-white px-7 py-3.5 rounded-full font-medium hover:bg-primary-ink transition-colors whitespace-nowrap" href="/kontakt">
                Napisz do nas
            </a>
        </div>
    </section>
</BaseLayout>
