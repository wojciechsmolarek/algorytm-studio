---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Schema from "../../components/seo/Schema.astro";
import { siteConfig } from "../../config/site";

const metadata = {
    title: "SEO w modelu pre-paid",
    description: "Elastyczny model współpracy SEO w systemie pre-paid. Kupujesz pakiet godzin, my realizujemy zadania według Twoich priorytetów.",
};

const advantages = [
    {
        title: "Pełna kontrola budżetu",
        description: "Wiesz dokładnie, ile wydajesz. Kupujesz pakiet godzin z góry i decydujesz, na co je przeznaczyć. Bez ukrytych kosztów.",
    },
    {
        title: "Brak długoterminowych umów",
        description: "Nie wiążesz się umową na 12 miesięcy. Kupujesz tyle godzin, ile aktualnie potrzebujesz. Skalujesz w górę lub w dół.",
    },
    {
        title: "Transparentne rozliczenie",
        description: "Każda godzina jest udokumentowana. Wiesz dokładnie, jakie zadania zostały zrealizowane i ile czasu zajęły.",
    },
    {
        title: "Elastyczność działań",
        description: "Dziś potrzebujesz audytu, jutro optymalizacji treści, za tydzień analizy konkurencji. Ty decydujesz o priorytetach.",
    },
];

const howItDiffers = [
    {
        title: "Tradycyjny model agencyjny",
        items: [
            "Umowa na 12+ miesięcy",
            "Stały abonament niezależnie od pracy",
            "Narzucony zakres działań",
            "Rozliczenie za efekt (często nieokreślony)",
            "Brak wglądu w realne godziny pracy",
        ],
        isHighlighted: false,
    },
    {
        title: "Nasz model pre-paid",
        items: [
            "Bez umów długoterminowych",
            "Płacisz za realne godziny pracy",
            "Ty decydujesz o priorytetach",
            "Rozliczenie za czas i konkretne zadania",
            "Pełna transparentność i raporty",
        ],
        isHighlighted: true,
    },
];

const processSteps = [
    {
        num: "01",
        title: "Wybierz pakiet",
        description: "Dobierz liczbę godzin do skali Twojego projektu. Pakiety od 10 do 80 godzin miesięcznie z degresywną stawką.",
    },
    {
        num: "02",
        title: "Ustal priorytety",
        description: "Wspólnie tworzymy listę zadań i ustalamy ich kolejność. Ty decydujesz, co jest najważniejsze dla Twojego biznesu.",
    },
    {
        num: "03",
        title: "Realizacja i raport",
        description: "Realizujemy zadania według ustalonych priorytetów. Po każdym okresie rozliczeniowym dostajesz raport z wykonanych prac.",
    },
];
const pageUrl = new URL(Astro.url.pathname, siteConfig.url).toString();
const schemaGraph = [
    { type: "Service" as const, data: { title: metadata.title, description: metadata.description, url: pageUrl } },
];

---

<BaseLayout {metadata}>
    <Schema graph={schemaGraph} />
    <!-- Hallmark · oferta: long-document macro — hairline rows, no eyebrow pills, no 3-col cards -->

    <!-- Hero — asymmetric, no eyebrow pill, no accent-emphasis word in H1 -->
    <section class="pt-36 md:pt-44 pb-20 px-6 md:px-12 lg:px-24 bg-surface">
        <div class="max-w-6xl mx-auto">
            <div class="reveal-on-scroll max-w-3xl">
                <h1 class="font-serif text-4xl md:text-6xl lg:text-7xl leading-[1.05] mb-8 text-balance">
                    SEO w modelu "pre-paid"
                </h1>
                <p class="text-xl text-foreground leading-relaxed mb-4 max-w-2xl">
                    Kupujesz godziny pracy eksperta, nie abonament.
                </p>
                <p class="text-lg text-ink-soft leading-relaxed max-w-2xl">
                    Pełna transparentność, elastyczność i kontrola nad budżetem SEO. Płacisz za realne godziny pracy, nie za obietnice.
                </p>
            </div>
        </div>
    </section>

    <!-- Comparison — pricing/package cards, de-templated -->
    <section class="py-20 md:py-24 px-6 md:px-12 lg:px-24">
        <div class="max-w-6xl mx-auto">
            <div class="mb-12 reveal-on-scroll max-w-3xl">
                <h2 class="font-serif text-2xl md:text-4xl leading-tight text-balance">
                    Dlaczego pre-paid?
                </h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {howItDiffers.map((model) => (
                    <div class={`bg-card border border-border p-7 rounded-lg reveal-on-scroll ${model.isHighlighted ? 'ring-2 ring-primary' : ''}`}>
                        <h3 class="font-serif text-xl md:text-2xl text-foreground mb-6">{model.title}</h3>
                        <ul class="flex flex-col gap-3">
                            {model.items.map((item) => (
                                <li class="flex items-start gap-3 text-base text-ink-soft leading-relaxed">
                                    <span class="mt-2 w-1.5 h-1.5 rounded-full bg-primary shrink-0"></span>
                                    {item}
                                </li>
                            ))}
                        </ul>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Advantages — 2-col asymmetric, not 3-col cards -->
    <section class="py-20 md:py-24 px-6 md:px-12 lg:px-24 bg-surface">
        <div class="max-w-6xl mx-auto">
            <div class="mb-12 reveal-on-scroll max-w-3xl">
                <h2 class="font-serif text-2xl md:text-4xl leading-tight text-balance">
                    Co zyskujesz w modelu pre-paid?
                </h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10">
                {advantages.map((item) => (
                    <div class="border-t border-border-strong pt-5 reveal-on-scroll">
                        <h3 class="font-serif text-lg md:text-xl text-foreground mb-2">{item.title}</h3>
                        <p class="text-base text-ink-soft leading-relaxed">{item.description}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Process — genuinely numbered, hairline rows with ordinal -->
    <section class="py-20 md:py-24 px-6 md:px-12 lg:px-24">
        <div class="max-w-6xl mx-auto">
            <div class="mb-12 reveal-on-scroll max-w-3xl">
                <h2 class="font-serif text-2xl md:text-4xl leading-tight text-balance">
                    Jak zaczynamy?
                </h2>
            </div>
            <div class="border-t-2 border-foreground">
                {processSteps.map((step) => (
                    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 py-8 md:py-10 border-b border-border-strong reveal-on-scroll">
                        <div class="md:col-span-2">
                            <span class="font-serif text-3xl text-primary tabular-nums">{step.num}</span>
                        </div>
                        <div class="md:col-span-10">
                            <h3 class="font-serif text-xl md:text-2xl text-foreground mb-2">{step.title}</h3>
                            <p class="text-base text-ink-soft leading-relaxed">{step.description}</p>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- CTA — letter-style, not bg-primary rounded-3xl card -->
    <section class="py-20 md:py-28 px-6 md:px-12 lg:px-24 bg-surface">
        <div class="max-w-3xl mx-auto text-center reveal-on-scroll">
            <h2 class="font-serif text-3xl md:text-5xl leading-tight mb-6 text-balance">
                Zacznij od pierwszego pakietu.
            </h2>
            <p class="text-lg text-ink-soft leading-relaxed mb-10 max-w-xl mx-auto">
                Nie musisz decydować się na wszystko od razu. Zacznij od małego pakietu, przetestuj nasz model współpracy i skaluj dalej.
            </p>
            <a
                class="inline-flex items-center bg-primary text-white px-7 py-3.5 rounded-full font-medium hover:bg-primary-ink transition-colors whitespace-nowrap"
                href="/kontakt"
            >
                Zapytaj o cennik
            </a>
        </div>
    </section>
</BaseLayout>
