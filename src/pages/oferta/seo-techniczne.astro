---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Schema from "../../components/seo/Schema.astro";
import { siteConfig } from "../../config/site";

const metadata = {
    title: "SEO Techniczne",
    description:
        "Audyt i optymalizacja techniczna SEO dla firm i sklepów e-commerce. Znajdziemy i naprawimy błędy, przez które Google pomija Twoje strony.",
};

const painPoints = [
    {
        symptom: "Duży ruch z reklam, ale organika stoi w miejscu",
        cause: "Roboty Google marnują budżet crawl na strony bez wartości i nie docierają do kluczowych podstron. Płacisz za reklamę, która prowadzi do witryny, której Google nie potrafi poprawnie zaindeksować.",
    },
    {
        symptom: "Migracja lub redesign strony i nagły spadek pozycji",
        cause: "Najczęściej: błędnie skonfigurowane przekierowania 301, utracone canonical albo zepsuta mapa linkowania wewnętrznego.",
    },
    {
        symptom: "Tysiące produktów, a Google widzi tylko część",
        cause: "Paginacja, duplikaty URL z filtrów fasetowych, nieoptymalna architektura kategorii — każda z tych rzeczy osobno blokuje indeksację. Razem potrafią ukryć przed Google większość katalogu.",
    },
    {
        symptom: "Strona ładuje się wolno mimo szybkiego hostingu",
        cause: "Niezoptymalizowane obrazy, blokujące skrypty JS lub brak CDN — Core Web Vitals spadają, a z nimi pozycje i konwersja.",
    },
];

const deliverables = [
    {
        num: "01",
        title: "Audyt techniczny",
        time: "tydzień 1–2",
        description:
            "Szczegółowa analiza indeksowalności, wydajności, struktury URL, linkowania wewnętrznego, Schema.org i Core Web Vitals. Wynik: raport PDF + arkusz zadań z priorytetami.",
    },
    {
        num: "02",
        title: "Sesja omówienia z zespołem",
        time: "tydzień 3",
        description:
            "Wspólne spotkanie (online lub stacjonarnie) z Twoim deweloperem i/lub CMO. Omawiamy każde znalezisko, odpowiadamy na pytania, ustalamy harmonogram wdrożeń.",
    },
    {
        num: "03",
        title: "Wdrożenie i nadzór",
        time: "tydzień 4+",
        description:
            "Wspieramy Twój zespół deweloperski na każdym etapie wdrożenia lub sami implementujemy zmiany. Każda poprawka jest weryfikowana i monitorowana w GSC.",
    },
];

const features = [
    {
        title: "Core Web Vitals",
        description:
            "Optymalizacja LCP, INP i CLS — kluczowych wskaźników UX, które bezpośrednio wpływają na ranking i konwersję.",
    },
    {
        title: "Indeksowalność i crawl budget",
        description:
            "Zapewniamy, że roboty Google skupiają się na stronach, które mają znaczenie. Robots.txt, canonical, hreflang, paginacja.",
    },
    {
        title: "Architektura informacji",
        description:
            "Struktura URL, linkowanie wewnętrzne, breadcrumbs — logiczna hierarchia wspierająca jednocześnie SEO i UX.",
    },
    {
        title: "Dane strukturalne (Schema.org)",
        description:
            "Implementacja znaczników dla rich snippets: FAQ, BreadcrumbList, Product, Organization — więcej miejsca w wynikach wyszukiwania.",
    },
    {
        title: "Bezpieczeństwo i HTTPS",
        description:
            "Migracja na HTTPS, konfiguracja nagłówków bezpieczeństwa, eliminacja mixed content i podatności technicznych.",
    },
    {
        title: "Migracje i redesigny",
        description:
            "Nadzór techniczny nad migracjami CMS, przeprojektowaniami i wdrożeniami headless — bez utraty pozycji w Google.",
    },
];

const faqs = [
    {
        question: "Czym różi się audyt techniczny od pełnego audytu SEO?",
        answer: "Audyt techniczny skupia się wyłącznie na warstwie technicznej strony: jak Google ją crawluje, indeksuje i ocenia pod kątem wydajności. Pełne SEO to dodatkowo treści, słowa kluczowe i linki zewnętrzne. Często techniczny jest pierwszym krokiem — bez solidnych fundamentów reszta nie przynosi efektów.",
    },
    {
        question: "Ile trwa audyt i kiedy zobaczę efekty?",
        answer: "Audyt realizujemy w 10–14 dni roboczych. Efekty wdrożeń są widoczne zazwyczaj po 4–12 tygodniach, zależnie od tego jak często Google crawluje Twoją witrynę. Priorytetyzujemy zmiany tak, żebyś szybkie wygrane widział już w pierwszym miesiącu.",
    },
    {
        question: "Czy pracujecie z naszym deweloperem czy sami wdrażacie?",
        answer: "Oba scenariusze są możliwe. Większość klientów woli, żebyśmy przekazali zadania ich zespołowi z pełną dokumentacją. Jeśli wolisz, możemy też wdrożyć zmiany samodzielnie — pracujemy z każdym nowoczesnym CMS i frameworkiem.",
    },
    {
        question: "Dla jakich platform pracujecie?",
        answer: "Pracujemy z każdą platformą: WordPress, Shopify, WooCommerce, Magento, PrestaShop, Shoper, IdoSell, a także z rozwiązaniami headless (Next.js, Astro, Nuxt). Jeśli Twoja strona jest w internecie, możemy ją zaudytować.",
    },
    {
        question: "Czy oferujecie abonament po audycie?",
        answer: "Tak. Po wdrożeniu zmian oferujemy stały nadzór techniczny w modelu miesięcznym — monitorowanie GSC, reagowanie na nowe błędy, bieżące konsultacje i kwartalne mini-audyty.",
    },
];
const pageUrl = new URL(Astro.url.pathname, siteConfig.url).toString();
const schemaGraph = [
    { type: "Service" as const, data: { title: metadata.title, description: metadata.description, url: pageUrl } },
    { type: "FAQPage" as const, data: { url: pageUrl, faqs } },
];

---

<BaseLayout {metadata}>
    <Schema graph={schemaGraph} />
    <!-- Hallmark · oferta: long-document macro — hairline rows, no eyebrow pills, no 3-col cards -->

    <!-- Hero — asymmetric, no eyebrow pill, no accent-emphasis word in H1 -->
    <section class="pt-36 md:pt-44 pb-20 px-6 md:px-12 lg:px-24 bg-surface">
        <div class="max-w-6xl mx-auto">
            <div class="reveal-on-scroll max-w-3xl">
                <h1 class="font-serif text-4xl md:text-6xl lg:text-7xl leading-[1.05] mb-8 text-balance">
                    SEO Techniczne
                </h1>
                <p class="text-xl text-foreground leading-relaxed mb-4 max-w-2xl">
                    Google może nie widzieć połowy Twojej strony — i Ty możesz o tym nie wiedzieć.
                </p>
                <p class="text-lg text-ink-soft leading-relaxed max-w-2xl">
                    Audytujemy fundamenty techniczne, które decydują o tym czy Twoje treści w ogóle trafiają do indeksu. Bez sprawnej techniki każda złotówka wydana na content i linki jest częściowo zmarnowana.
                </p>
            </div>
        </div>
    </section>

    <!-- Pain Points — hairline rows, not 2-col cards -->
    <section class="py-20 md:py-24 px-6 md:px-12 lg:px-24">
        <div class="max-w-6xl mx-auto">
            <div class="mb-12 reveal-on-scroll max-w-3xl">
                <h2 class="font-serif text-2xl md:text-4xl leading-tight text-balance">
                    Objawy, które widzimy najczęściej
                </h2>
            </div>
            <div class="border-t-2 border-foreground">
                {painPoints.map((item) => (
                    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 py-7 md:py-8 border-b border-border-strong reveal-on-scroll">
                        <div class="md:col-span-5">
                            <p class="text-lg font-medium text-foreground">{item.symptom}</p>
                        </div>
                        <div class="md:col-span-7">
                            <p class="text-base text-ink-soft leading-relaxed">{item.cause}</p>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Deliverables / Process — genuinely numbered, hairline rows with ordinal -->
    <section class="py-20 md:py-24 px-6 md:px-12 lg:px-24 bg-surface">
        <div class="max-w-6xl mx-auto">
            <div class="mb-12 reveal-on-scroll max-w-3xl">
                <h2 class="font-serif text-2xl md:text-4xl leading-tight text-balance mb-3">
                    Co dostajesz i kiedy
                </h2>
                <p class="text-ink-soft">Trzy etapy, od audytu po wdrożenie.</p>
            </div>
            <div class="border-t-2 border-foreground">
                {deliverables.map((step) => (
                    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 py-8 md:py-10 border-b border-border-strong reveal-on-scroll">
                        <div class="md:col-span-2">
                            <span class="font-serif text-3xl text-primary tabular-nums">{step.num}</span>
                        </div>
                        <div class="md:col-span-7">
                            <h3 class="font-serif text-xl md:text-2xl text-foreground mb-2">{step.title}</h3>
                            <p class="text-base text-ink-soft leading-relaxed">{step.description}</p>
                        </div>
                        <div class="md:col-span-3 md:text-right">
                            <span class="text-xs uppercase tracking-widest text-muted-foreground">{step.time}</span>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Features — 2-col asymmetric, not 3-col cards -->
    <section class="py-20 md:py-24 px-6 md:px-12 lg:px-24">
        <div class="max-w-6xl mx-auto">
            <div class="mb-12 reveal-on-scroll max-w-3xl">
                <h2 class="font-serif text-2xl md:text-4xl leading-tight text-balance">
                    Co obejmuje audyt techniczny
                </h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10">
                {features.map((feature) => (
                    <div class="border-t border-border-strong pt-5 reveal-on-scroll">
                        <h3 class="font-serif text-lg md:text-xl text-foreground mb-2">{feature.title}</h3>
                        <p class="text-base text-ink-soft leading-relaxed">{feature.description}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Social Proof — stats as inline row with hairline dividers, not 3 cards -->
    <section class="py-20 md:py-24 px-6 md:px-12 lg:px-24 bg-surface">
        <div class="max-w-6xl mx-auto">
            <div class="mb-12 reveal-on-scroll max-w-3xl">
                <h2 class="font-serif text-2xl md:text-4xl leading-tight text-balance">
                    Wyniki po audycie
                </h2>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 mb-12 reveal-on-scroll">
                <div class="border-t-2 border-foreground pt-5">
                    <p class="font-serif text-4xl md:text-5xl text-primary mb-2 tabular-nums">+187%</p>
                    <p class="text-sm text-ink-soft leading-relaxed">wzrost widoczności organicznej w 4 miesiące po audycie dla sklepu B2B z branży przemysłowej</p>
                </div>
                <div class="border-t-2 border-foreground pt-5">
                    <p class="font-serif text-4xl md:text-5xl text-primary mb-2 tabular-nums">12 dni</p>
                    <p class="text-sm text-ink-soft leading-relaxed">średni czas realizacji pełnego audytu technicznego z priorytetyzowaną listą zadań</p>
                </div>
                <div class="border-t-2 border-foreground pt-5">
                    <p class="font-serif text-4xl md:text-5xl text-primary mb-2 tabular-nums">40+</p>
                    <p class="text-sm text-ink-soft leading-relaxed">przeprowadzonych audytów dla firm produkcyjnych, dystrybutorów i sklepów e-commerce</p>
                </div>
            </div>

            <!-- Testimonial — blockquote, no boxed card -->
            <blockquote class="max-w-3xl reveal-on-scroll border-l-2 border-foreground pl-6">
                <p class="text-xl md:text-2xl font-serif leading-relaxed mb-5 text-balance">
                    "Po audycie okazało się, że Google indeksowało tylko 30% naszego katalogu produktów. W ciągu 3 miesięcy od wdrożenia zmian ruch organiczny wzrósł o ponad 150%."
                </p>
                <footer class="text-sm text-muted-foreground">
                    <strong class="text-foreground">Jolanta Maszczyk</strong> — Dyrektor marketingu sklepu e-commerce
                </footer>
            </blockquote>
        </div>
    </section>

    <!-- FAQ — hairline rows, not stacked cards -->
    <section class="py-20 md:py-24 px-6 md:px-12 lg:px-24">
        <div class="max-w-6xl mx-auto">
            <div class="mb-12 reveal-on-scroll max-w-3xl">
                <h2 class="font-serif text-2xl md:text-4xl leading-tight text-balance">
                    Pytania, które słyszymy najczęściej
                </h2>
            </div>
            <div class="border-t-2 border-foreground">
                {faqs.map((faq) => (
                    <details class="border-b border-border-strong reveal-on-scroll group">
                        <summary class="flex items-center justify-between gap-4 py-6 cursor-pointer list-none">
                            <h3 class="text-lg font-medium text-foreground">{faq.question}</h3>
                            <span class="text-primary text-xl shrink-0 group-open:rotate-45 transition-transform">+</span>
                        </summary>
                        <p class="text-base text-ink-soft leading-relaxed pb-6 pr-8">{faq.answer}</p>
                    </details>
                ))}
            </div>
        </div>
    </section>

    <!-- CTA — letter-style, not bg-primary rounded-3xl card -->
    <section class="py-20 md:py-28 px-6 md:px-12 lg:px-24 bg-surface">
        <div class="max-w-3xl mx-auto text-center reveal-on-scroll">
            <h2 class="font-serif text-3xl md:text-5xl leading-tight mb-6 text-balance">
                Sprawdźmy czy Google widzi Twoją stronę w całości.
            </h2>
            <p class="text-lg text-ink-soft leading-relaxed mb-10 max-w-xl mx-auto">
                Napisz do nas, a w ciągu 24 godzin odezwiemy się z wstępną oceną Twojej strony. Bez zobowiązań — tylko konkretna informacja co blokuje Twój wzrost organiczny.
            </p>
            <a
                class="inline-flex items-center bg-primary text-white px-7 py-3.5 rounded-full font-medium hover:bg-primary-ink transition-colors whitespace-nowrap"
                href="/kontakt"
            >
                Napisz do nas
            </a>
        </div>
    </section>
</BaseLayout>
