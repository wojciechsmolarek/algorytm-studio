---
interface Props {
    title?: string;
    description?: string;
    ogImage?: string;
    ogType?: string;
    canonical?: string;
    metadata?: {
        title?: string;
        description?: string;
        ogImage?: string;
        ogType?: string;
        canonical?: string;
        ignoreTitleTemplate?: boolean;
        breadcrumbLabels?: Record<string, string>;
    };
}

import Seo from "../components/seo/Seo.astro";
import Schema from "../components/seo/Schema.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import "../styles/global.css";
import SpeedInsights from "@vercel/speed-insights/astro";
import Analytics from "@vercel/analytics/astro";

import { siteConfig } from "../config/site";
import { experts } from "../config/experts";
import { generateBreadcrumbs } from "../lib/schema";

const { title, description, ogImage, ogType, canonical, metadata } = Astro.props;

const finalTitle = metadata?.title || title;
const finalDescription = metadata?.description || description;
const finalOgImage = metadata?.ogImage || ogImage;
const finalOgType = metadata?.ogType || ogType;
const finalCanonical = metadata?.canonical || canonical;
const finalIgnoreTitleTemplate = metadata?.ignoreTitleTemplate || false;
const finalBreadcrumbLabels = metadata?.breadcrumbLabels;

// Build global schema graph: WebSite + Organization + BreadcrumbList
const founders = experts.map((e) => ({
    "@type": "Person" as const,
    name: e.name,
    url: new URL(`/ekspert/${e.slug}`, siteConfig.url).toString(),
}));

const normalizedPath =
    Astro.url.pathname === "/"
        ? "/"
        : Astro.url.pathname.replace(/\/$/, "");
const pageUrl = new URL(normalizedPath, siteConfig.url).toString();
const autoBreadcrumbs = generateBreadcrumbs(Astro.url.pathname, finalBreadcrumbLabels);
const showBreadcrumbs = Astro.url.pathname !== "/";

const globalGraph = [
    { type: "WebSite" as const, data: {} },
    { type: "Organization" as const, data: { founders } },
    ...(showBreadcrumbs
        ? [{ type: "BreadcrumbList" as const, data: { breadcrumbs: autoBreadcrumbs, url: pageUrl } }]
        : []),
];
---

<!doctype html>
<html lang={siteConfig.lang} class="scroll-smooth" data-theme="light">
    <head>
        <Seo
            title={finalTitle}
            description={finalDescription}
            ogImage={finalOgImage}
            ogType={finalOgType}
            canonical={finalCanonical}
            ignoreTitleTemplate={finalIgnoreTitleTemplate}
        />
        <Schema graph={globalGraph} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="preload"
            as="style"
            href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&display=swap"
        />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&display=swap"
            media="print"
            onload="this.media='all'"
        />
        <noscript>
            <link
                rel="stylesheet"
                href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&display=swap"
            />
        </noscript>
        <slot name="head" />
    </head>
    <body
        class="bg-background text-foreground font-sans antialiased transition-colors duration-300"
    >
        <a
            href="#main-content"
            class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 z-50 rounded-md bg-primary px-4 py-2 text-background shadow-lg ring-2 ring-background"
        >
            Przejdź do strony
        </a>

        <div class="relative flex min-h-screen flex-col overflow-x-hidden">
            <Navbar />
            <main id="main-content" class="relative z-10 grow">
                <slot />
            </main>
            <Footer />
        </div>

        <script is:inline>
            // Intersection Observer for scroll animations
            document.addEventListener("DOMContentLoaded", () => {
                const observer = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((entry) => {
                            if (entry.isIntersecting) {
                                entry.target.classList.add("reveal-visible");
                            }
                        });
                    },
                    { threshold: 0.1 },
                );
                document
                    .querySelectorAll(".reveal-on-scroll")
                    .forEach((el) => observer.observe(el));
            });
        </script>

        <SpeedInsights />
        <Analytics />
    </body>
</html>
